{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Benchmark: run all models",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["benchmark\\run_benchmark.py"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "HF_HUB_DISABLE_SYMLINKS_WARNING": "1", "PYTHONIOENCODING": "utf-8" }
            },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Benchmark: export doctor review files",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["benchmark\\export_doctor_review.py"],
            "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        }
    ]
}
